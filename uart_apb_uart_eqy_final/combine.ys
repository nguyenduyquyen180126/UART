plugin -i /tmp/uart-eqy-src/src/eqy_combine.so
read_rtlil uart_apb_uart_eqy_final/gold.il
uniquify
hierarchy
design -stash gold
read_rtlil uart_apb_uart_eqy_final/gate_recoded.il
uniquify
hierarchy
design -stash gate
eqy_combine -gold_ids uart_apb_uart_eqy_final/gold.ids -gate_ids uart_apb_uart_eqy_final/gate_recoded.ids
write_rtlil uart_apb_uart_eqy_final/combined.il
