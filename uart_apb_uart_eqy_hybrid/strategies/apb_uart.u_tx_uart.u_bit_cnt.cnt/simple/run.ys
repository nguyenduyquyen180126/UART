verilog_defaults -add -D CHECK_OUTPUTS
read_verilog -sv ../../../partitions/apb_uart.u_tx_uart.u_bit_cnt.cnt.sv
read_rtlil ../../../partitions/apb_uart.u_tx_uart.u_bit_cnt.cnt.il
hierarchy -top miter; proc; chformal -cover -remove
async2sync
formalff -clk2ff -ff2anyinit gate.apb_uart.u_tx_uart.u_bit_cnt.cnt
setundef -anyseq gate.apb_uart.u_tx_uart.u_bit_cnt.cnt
flatten -wb; dffunmap; opt_expr -keepdc -undriven; opt_clean
sat -tempinduct -set-init-undef -set-def-formal -set-def-inputs -maxsteps 50 -set-assumes -prove-asserts -show-public -dump_vcd trace.vcd miter
