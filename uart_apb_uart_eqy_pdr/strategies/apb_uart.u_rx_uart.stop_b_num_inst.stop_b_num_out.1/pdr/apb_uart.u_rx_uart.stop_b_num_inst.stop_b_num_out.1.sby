[options]
mode prove
depth 5
expect pass,fail,unknown,timeout

timeout 120

[engines]
abc pdr

[script]
verilog_defaults -add -D CHECK_OUTPUTS
read_verilog -sv ../../../../../partitions/apb_uart.u_rx_uart.stop_b_num_inst.stop_b_num_out.1.sv
read_rtlil ../../../../../partitions/apb_uart.u_rx_uart.stop_b_num_inst.stop_b_num_out.1.il
hierarchy -top miter; proc

async2sync
formalff -clk2ff -ff2anyinit gate.apb_uart.u_rx_uart.stop_b_num_inst.stop_b_num_out.1
setundef -anyseq gate.apb_uart.u_rx_uart.stop_b_num_inst.stop_b_num_out.1
flatten -wb; dffunmap; opt_expr -keepdc -undriven; opt_clean
xprop -formal -split-ports -assume-def-inputs miter

