# running in apb_uart.tx_done_status/src/
verilog_defaults -add -D CHECK_OUTPUTS
read_verilog -sv ../../../../../partitions/apb_uart.tx_done_status.sv
read_rtlil ../../../../../partitions/apb_uart.tx_done_status.il
hierarchy -top miter; proc

async2sync
formalff -clk2ff -ff2anyinit gate.apb_uart.tx_done_status
setundef -anyseq gate.apb_uart.tx_done_status
flatten -wb; dffunmap; opt_expr -keepdc -undriven; opt_clean
xprop -formal -split-ports -assume-def-inputs miter

hierarchy -smtcheck
rename -witness
write_jny -no-connections ../model/design.json
write_rtlil ../model/design.il
