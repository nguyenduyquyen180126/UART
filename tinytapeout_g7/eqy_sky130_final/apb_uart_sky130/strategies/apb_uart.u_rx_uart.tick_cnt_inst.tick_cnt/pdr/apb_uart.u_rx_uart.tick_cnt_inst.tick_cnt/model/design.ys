# running in apb_uart.u_rx_uart.tick_cnt_inst.tick_cnt/src/
verilog_defaults -add -D CHECK_OUTPUTS
read_verilog -sv ../../../../../partitions/apb_uart.u_rx_uart.tick_cnt_inst.tick_cnt.sv
read_rtlil ../../../../../partitions/apb_uart.u_rx_uart.tick_cnt_inst.tick_cnt.il
hierarchy -top miter; proc

async2sync
formalff -clk2ff -ff2anyinit gate.apb_uart.u_rx_uart.tick_cnt_inst.tick_cnt
setundef -anyseq gate.apb_uart.u_rx_uart.tick_cnt_inst.tick_cnt
flatten -wb; dffunmap; opt_expr -keepdc -undriven; opt_clean
xprop -formal -split-ports -assume-def-inputs miter

hierarchy -smtcheck
rename -witness
write_jny -no-connections ../model/design.json
write_rtlil ../model/design.il
